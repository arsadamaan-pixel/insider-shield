{
  "manifest_version": 3,
  "name": "Insider-Shield",
  "version": "0.5.0",
  "description": "Insider-Shield enterprise endpoint agent — managed-policy DLP monitoring, real-time telemetry, per-device provisioning tokens, and per-employee session revocation.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Insider-Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardRead",
    "alarms"
  ]
}
