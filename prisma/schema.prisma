// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Employee {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  department      String
  riskScore       Int
  status          String // "active" | "suspended" | "offboarded"
  createdAt       DateTime  @default(now())
  title           String?
  // The device an employee's extension is bound to. Unique so two
  // employees can never claim the same device; nullable+unique is safe
  // in SQLite (NULLs never collide).
  managedDeviceId String?   @unique
  // Bumped by ingestHeartbeat() whenever a heartbeat carries a matching
  // employeeEmail — see src/lib/telemetryIngest.ts.
  lastSeenAt      DateTime?
  lastKnownIp     String?
  offboardedAt    DateTime?
}

// `snippet` and `redactedContent` are both always pre-redacted values
// (masked excerpts / metadata-only descriptions) produced upstream by
// the extension content script or the telemetry route — never the raw
// matched sensitive text. No column in this table stores un-redacted
// user content.
model DlpAlert {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  severity        String // "low" | "medium" | "high" | "critical"
  employeeEmail   String
  ruleTriggered   String
  snippet         String
  redactedContent String
  sourceUrl       String
  geoViolation    Boolean  @default(false)
  acknowledged    Boolean  @default(false)
}

// Key/value rows so the policy shape can evolve without a migration per
// field. `value` is JSON-encoded since fields vary in type (boolean,
// number, array, string) — see src/lib/policyStore.ts for the
// encode/decode logic shared with extension/background/background.js's
// policy schema.
model SystemPolicy {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Heartbeat {
  id            String   @id @default(cuid())
  orgKey        String
  // Set when the sending agent's connection carried a recognized
  // employeeEmail — see server.ts's WS upgrade handler and
  // src/lib/telemetryIngest.ts's ingestHeartbeat().
  employeeEmail String?
  // ProvisioningToken.id of the credential this agent authenticated
  // with, when it used a per-device token rather than the shared
  // ORG_ACCESS_KEY. This is the closest thing to a stable device
  // identity the system has — the token carries the admin-assigned
  // deviceName — so it's what the Endpoints view groups agents by.
  tokenId       String?
  ipAddress     String?
  platform      String // JSON-encoded { os, arch }
  timestamp     DateTime @default(now())
  status        String

  @@index([employeeEmail])
  @@index([tokenId])
}

// Per-device/per-employee credentials an admin can generate, list, and
// revoke for the extension agent to present instead of (or alongside)
// the single org-wide ORG_ACCESS_KEY — see src/lib/agentTokens.ts. Only
// a SHA-256 hash of the raw token is ever stored; the raw value is
// returned once in the creation API response and never persisted or
// retrievable again (same pattern as GitHub/Stripe API keys).
model ProvisioningToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  // First chars of the raw token — safe to display so an admin can tell
  // rows apart in the UI without ever re-exposing the full secret.
  tokenPrefix String
  // Employee.id — nullable, a token can be generated before an employee
  // is assigned (e.g. pre-provisioning a device for a new hire).
  employeeId  String?
  deviceName  String?
  status      String    @default("active") // "active" | "revoked"
  createdBy   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  // Bumped on every successful auth — lets the dashboard distinguish
  // "issued but never used" from "actively in use" without a separate
  // stored status value.
  lastUsedAt  DateTime?

  @@index([status])
  @@index([employeeId])
}

// Append-only security audit trail — see src/lib/auditLog.ts's
// logAuditEvent(). `action` is a free-form string (matches this
// schema's existing convention for Employee.status/DlpAlert.severity),
// not a Prisma enum — see src/types/auditLog.ts's AUDIT_ACTIONS for the
// known set used by the Audit page's filter UI.
model AuditLog {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  actorEmail     String
  action         String
  targetResource String
  detailsJson    String?
  ipAddress      String?

  @@index([timestamp])
  @@index([action])
}
