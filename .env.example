# Copy to .env and fill in real values. .env is gitignored.

DATABASE_URL="file:./dev.db"
# In production (Render/Docker), point this at a Turso database instead,
# e.g. "libsql://insider-shield-<org>.turso.io" — see README.md's
# deployment section. TURSO_AUTH_TOKEN below is required whenever
# DATABASE_URL is a libsql://, http://, or https:// URL.
TURSO_AUTH_TOKEN=""

# Shared secret Chrome-extension agents must present (WS query param /
# X-Org-Access-Key header) — see extension/options/options.html.
# Generate your own long random value, e.g. `openssl rand -hex 32` —
# never commit a real value here or reuse an example from docs/tutorials.
ORG_ACCESS_KEY=""

# Shared secret required to log in to the SOC dashboard at /login.
# Same guidance as above: generate your own, e.g. `openssl rand -hex 32`.
# Only used when Google Sign-In (below) is NOT configured — once
# GOOGLE_CLIENT_ID/SECRET are set, this token form is disabled for this
# deployment and only Google Sign-In is offered, since a standing shared
# secret next to per-person verified login would defeat the point.
BEARER_TOKEN=""

# HMAC key that signs the dashboard session cookie. Must be a different
# value from BEARER_TOKEN. Same guidance: `openssl rand -hex 32`.
SESSION_SECRET=""

# Optional. Absolute or relative path to a local MaxMind GeoLite2-City
# database (.mmdb) used to resolve real employee/device locations on the
# Asset Map from their lastKnownIp — see src/lib/geoip.ts. Left unset,
# the Asset Map falls back to deterministic mock city positions (today's
# behavior); nothing else breaks.
#
# To get one (free): create a MaxMind account at
# https://www.maxmind.com/en/geolite2/signup, generate a license key
# under Account > License Keys, then download with:
#   curl -o GeoLite2-City.tar.gz \
#     "https://download.maxmind.com/app/geoip_download?edition_id=GeoLite2-City&license_key=YOUR_LICENSE_KEY&suffix=tar.gz"
#   tar xzf GeoLite2-City.tar.gz --strip-components=1 --wildcards "*/GeoLite2-City.mmdb"
# The .mmdb file is gitignored (binary, licensed) — never commit it.
# MaxMind's terms require you to refresh it periodically (they publish
# updates roughly weekly); this project does not automate that refresh.
GEOIP_DB_PATH="./GeoLite2-City.mmdb"

# Optional. Enables "Sign in with Google" on the dashboard login page —
# see src/lib/googleAuth.ts. Left unset, /login keeps using the
# BEARER_TOKEN form above unchanged. Every org self-hosting this project
# configures its own Google Cloud OAuth Client; nothing here is shared
# across deployments.
#
# Setup (one-time, per deployment, in your own Google Cloud project):
#   1. https://console.cloud.google.com/apis/credentials — create an
#      OAuth 2.0 Client ID, application type "Web application".
#   2. Under "Authorized redirect URIs" add BOTH
#      http://localhost:3000/api/auth/google/callback (local dev) and
#      https://<your-deployment-domain>/api/auth/google/callback
#      (production) — Google rejects any redirect that isn't registered
#      here exactly.
#   3. While the OAuth consent screen is unverified (the default,
#      "Testing" publishing status — fine for this use case, no Google
#      review needed since only openid/email/profile scopes are used),
#      add every Google account you intend to let sign in under
#      "Test users" — Google blocks anyone not listed here before this
#      app's own code ever runs, regardless of ALLOWED_DASHBOARD_EMAILS
#      below.
#   4. Copy the generated Client ID/Secret below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Access restriction for Google Sign-In — required (see above: Google
# Sign-In refuses every login if both of these are empty, rather than
# silently allowing any Google account). Set either or both:
#
# Comma-separated exact email addresses, e.g.
# "alice@company.com,bob@company.com" — for a team without Google
# Workspace.
ALLOWED_DASHBOARD_EMAILS=""
# Comma-separated Google Workspace domains, e.g. "company.com" — anyone
# signing in with an account on one of these domains is allowed, no
# per-person list to maintain. Leave unset if you don't use Workspace.
ALLOWED_GOOGLE_HD=""
