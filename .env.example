# Copy to .env and fill in real values. .env is gitignored.

DATABASE_URL="file:./dev.db"
# In production (Render/Docker), point this at a Turso database instead,
# e.g. "libsql://insider-shield-<org>.turso.io" — see README.md's
# deployment section. TURSO_AUTH_TOKEN below is required whenever
# DATABASE_URL is a libsql://, http://, or https:// URL.
TURSO_AUTH_TOKEN=""

# Shared secret Chrome-extension agents must present (WS query param /
# X-Org-Access-Key header) — see extension/options/options.html.
# Generate your own long random value, e.g. `openssl rand -hex 32` —
# never commit a real value here or reuse an example from docs/tutorials.
ORG_ACCESS_KEY=""

# Shared secret required to log in to the SOC dashboard at /login.
# Same guidance as above: generate your own, e.g. `openssl rand -hex 32`.
BEARER_TOKEN=""

# HMAC key that signs the dashboard session cookie. Must be a different
# value from BEARER_TOKEN. Same guidance: `openssl rand -hex 32`.
SESSION_SECRET=""
